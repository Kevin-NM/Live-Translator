{
  "manifest_version": 3,
  "name": "Live Translator - Audio Capture",
  "version": "0.2.1",
  "description": "Captures Chrome tab audio for Live Translator ASR pipeline",
  "permissions": [
    "tabCapture",
    "tabs",
    "activeTab",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live Translator"
  },
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ]
}
